x = int(input('Enter a number n to find the sum: '))
def sum(s):
    if s == 1:
        return 1
    else:
        return s + sum(s-1)
print(f'Sum = {sum(x)}')

#Q2
num = int(input('Enter a number n to find the factorial n!: '))
def factorial(n):
    if n <= 1:
        return 1
    else:
        return n * factorial(n-1)
print(f'Factorial: {factorial(num)}')
```

