### Mini project: a library system (Book / Library classes)

> **Note:** Two cooperating classes — a Book holds its own data, a Library manages a collection of Books.

```python
class Book:
    def __init__(self, title, author, available=True):
        self.title = title
        self.author = author
        self.available = available


class Library:
    def __init__(self):
        self.books = []

    def add_book(self, book):
        self.books.append(book)

    def borrow_book(self, title):
        for book in self.books:
            if book.title == title:
                if book.available:
                    book.available = False
                    print(f"'{title}' borrowed successfully.")
                else:
                    print(f"'{title}' is not available.")
                return
        print(f"'{title}' not found in library.")

    def display_books(self):
        print("\nBooks in library:")
        for book in self.books:
            status = "Available" if book.available else "Checked Out"
            print(f"{book.title} - {status}")


library = Library()
b1 = Book("Python Basics", "Joey")
b2 = Book("Data Science 101", "Amber", False)

library.add_book(b1)
library.add_book(b2)

library.borrow_book("Python Basics")
library.borrow_book("Data Science 101")
library.display_books()
```

